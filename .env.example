# Copier vers .env puis remplacer par un secret :
#   openssl rand -base64 32
REDIS_PASSWORD=change-moi

# Où les rapports sont écrits, une ligne de JSON par domaine connu. Le chemin
# peut être une socket Unix — un collecteur écoute à l'autre bout — ou un
# simple fichier, auquel les lignes sont ajoutées.
# PERSES_SOCKET=/tmp/perses.socket

# Relais DNS. Sans PERSES_DNS_BIND, le service écoute sur l'adresse que porte
# l'interface WireGuard, port 53 — jamais sur 0.0.0.0 : il est destiné aux
# seuls pairs du tunnel.
PERSES_DNS_BIND=10.8.0.1:53
# Résolveur interrogé pour les noms autorisés. Ne pas le faire pointer vers
# nous-mêmes : la question tournerait en rond.
PERSES_DNS_UPSTREAM=1.1.1.1:53
# Secondes avant d'abandonner une question, relais menés de front, questions
# en attente tolérées.
PERSES_DNS_TIMEOUT=3
PERSES_DNS_WORKERS=4
PERSES_DNS_QUEUE=256
