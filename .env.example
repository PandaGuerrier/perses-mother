# Copier vers .env puis remplacer par un secret :
#   openssl rand -base64 32
REDIS_PASSWORD=change-moi

# Où les rapports sont écrits, une ligne de JSON par domaine connu. Le chemin
# peut être une socket Unix — un collecteur écoute à l'autre bout — ou un
# simple fichier, auquel les lignes sont ajoutées.
# PERSES_SOCKET=/tmp/perses.socket
